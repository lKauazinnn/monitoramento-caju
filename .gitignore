# ESTE PROJETO NAO TEM DEPENDENCIA NPM, e isso e deliberado: os testes .mjs
# importam .ts direto usando a remocao nativa de tipos do Node 22+.
# Um package.json gerado por `npm init -y` vem com "type": "commonjs" e QUEBRA
# esses testes ("does not provide an export named ..."). Se algum dia um
# package.json for realmente necessario, ele PRECISA ter "type": "module".
package.json
package-lock.json
.simulador.pid
simulador.log
simulador.err.log

# Agente PowerShell local
.agente-ps.pid
agente-ps.out.log
agente-ps.err.log

# Pacotes gerados para outros PCs (contem token por maquina)
pacotes/
capturas/

# Producao (Supabase)
# config.toml nomeia o SEU projeto; config.producao.js traz a anon key daquele
# projeto. Nenhum dos dois e segredo, mas tambem nao pertencem ao repositorio:
# sao gerados por scripts/publicar-supabase.ps1 para a instalacao de cada um.
supabase/config.toml
dashboard/config.producao.js

# CLI do Supabase baixada por scripts/publicar-supabase.ps1 (~116 MB)
tools/

